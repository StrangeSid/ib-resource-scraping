{
  "mcpServers": {
    "ib-resources": {
      "command": "python3",
      "args": ["/absolute/path/to/ib-resource-scraping/mcp_server.py"],
      "env": {
        "IB_API_BASE": "https://ib-scrape.sidevv.xyz"
      }
    },
    "ib-resources-local": {
      "command": "/absolute/path/to/ib-resource-scraping/.venv/bin/python",
      "args": ["mcp_server.py"],
      "cwd": "/absolute/path/to/ib-resource-scraping",
      "env": {
        "STORE": "/absolute/path/to/ib-resource-scraping/store",
        "MANIFESTS": "/absolute/path/to/ib-resource-scraping/manifests"
      }
    }
  }
}
